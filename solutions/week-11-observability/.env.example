# Copy this file to .env and adjust values as needed. Never commit .env.
# The Makefile sources this file, so keep every comment on its own line:
# a comment after a value becomes part of the value.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflowdb
# Prefect's database in the same Postgres, created by init-prefect-db.sh on first start.
PREFECT_DB=prefectdb

# ── Silo ──────────────────────────────────────────────────────────────────────
# MLFLOW_BUCKET holds MLflow's artifacts. DVC_BUCKET holds the versioned data.
S3_ACCESS_KEY=s3_user
S3_SECRET_KEY=s3_password
MLFLOW_BUCKET=mlflow-artifacts
DVC_BUCKET=dvc-storage

# ── Host ports ────────────────────────────────────────────────────────────────
# Containers use each tool's default port. Only the host ports move to 55xx.
#   MLFLOW_PORT         host -> container 5000 (MLflow UI)
#   S3_API_PORT         host -> container 9000 (Silo S3 API, DVC's endpointurl)
#   S3_CONSOLE_PORT     host -> container 9001 (Silo console)
#   POSTGRES_HOST_PORT  host -> container 5432 (Postgres)
#   PREFECT_PORT        host -> container 4200 (Prefect UI and API)
#   PROMETHEUS_PORT     host -> container 9090 (Prometheus UI)
#   GRAFANA_PORT        host -> container 3000 (Grafana UI)
#   API_PORT            host -> container 8000 (the prediction service)
MLFLOW_PORT=5500
S3_API_PORT=5510
S3_CONSOLE_PORT=5511
POSTGRES_HOST_PORT=5532
PREFECT_PORT=5520
PROMETHEUS_PORT=5560
GRAFANA_PORT=5561
API_PORT=5562

# ── Grafana ───────────────────────────────────────────────────────────────────
# compose.yaml gives anonymous users the Editor role, so the lab needs no login.
# The admin account is only for settings an Editor cannot change.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Clients need the /api suffix. Without it every call returns 404.
PREFECT_API_URL=http://127.0.0.1:5520/api

# ── Pipeline (Python client) ──────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://127.0.0.1:5500
MLFLOW_EXPERIMENT_NAME=diabetes-week11

# The original dataset, committed to Git.
PIPELINE_DATA_PATH=data/diabetes.csv

# The DVC-tracked dataset the pipeline trains on. Missing in a fresh clone
# until you run `dvc pull` or `make data-v2`.
PIPELINE_MEASUREMENTS_PATH=data/measurements.csv

# Hyperparameters are in params.yaml, not here, so that DVC can track them.

# ── Model registry ────────────────────────────────────────────────────────────
MLFLOW_REGISTERED_MODEL_NAME=diabetes-classifier
MLFLOW_MODEL_ALIAS=staging
MLFLOW_MODEL_OWNER=your-name

# ── DVC remote ────────────────────────────────────────────────────────────────
DVC_REMOTE_NAME=storage
DVC_REMOTE_PATH=dvcstore

# DVC talks to Silo directly and reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# The Makefile maps the Silo keys above onto those names. To run dvc by hand:
#   set -a && . ./.env && set +a
#   export AWS_ACCESS_KEY_ID="$S3_ACCESS_KEY" AWS_SECRET_ACCESS_KEY="$S3_SECRET_KEY"
