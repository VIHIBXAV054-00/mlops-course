# Copy this file to .env and adjust values as needed.
# Never commit .env — it is git-ignored.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflowdb
# Prefect's own database in the same Postgres, created on first start.
PREFECT_DB=prefectdb

# ── Silo ──────────────────────────────────────────────────────────────────────
# One bucket for MLflow's artifacts, one for DVC's versioned data.
S3_ACCESS_KEY=s3_user
S3_SECRET_KEY=s3_password
MLFLOW_BUCKET=mlflow-artifacts
DVC_BUCKET=dvc-storage

# ── Host port mapping ─────────────────────────────────────────────────────────
# Only the host ports move, into the 55xx block, to dodge common local ports.
MLFLOW_PORT=5500          # host → container 5000 (MLflow UI)
S3_API_PORT=5510          # host → container 9000 (Silo S3 API)
S3_CONSOLE_PORT=5511      # host → container 9001 (Silo console)
POSTGRES_HOST_PORT=5532   # host → container 5432 (Postgres)
PREFECT_PORT=5520         # host → container 4200 (Prefect UI and API)

# The /api suffix is required; without it every call returns 404.
PREFECT_API_URL=http://127.0.0.1:5520/api

# ── Pipeline (Python client) ──────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://127.0.0.1:5500
MLFLOW_EXPERIMENT_NAME=diabetes-week9

# The original dataset, committed to Git.
PIPELINE_DATA_PATH=data/diabetes.csv

# The DVC-tracked dataset the pipeline trains on; make dvc-pull or make data-v2 creates it.
PIPELINE_MEASUREMENTS_PATH=data/measurements.csv

# ── Model registry ────────────────────────────────────────────────────────────
MLFLOW_REGISTERED_MODEL_NAME=diabetes-classifier
MLFLOW_MODEL_ALIAS=staging
MLFLOW_MODEL_OWNER=your-name

# ── DVC remote ────────────────────────────────────────────────────────────────
DVC_REMOTE_NAME=storage
DVC_REMOTE_PATH=dvcstore

# ── Credentials for DVC ───────────────────────────────────────────────────────
# DVC reaches Silo directly and reads AWS_* keys; the Makefile maps the S3_* values onto them.
# Never commit .dvc/config.local if you store keys there instead.
