# Copy this file to .env and adjust values as needed.
# Never commit .env — it is git-ignored.
#
# Every comment in this file sits on its own line. That is deliberate: the
# Makefile SOURCES this file (`set -a && . ./.env`) to hand Silo credentials to
# dvc, and trailing `# comments` after a value would end up inside the value.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflowdb

# ── Silo ──────────────────────────────────────────────────────────────────────
# MLFLOW_BUCKET holds MLflow's artifacts (Weeks 2-3).
# DVC_BUCKET holds versioned DATA (new in Week 4) — a second, separate tenant.
S3_ACCESS_KEY=s3_user
S3_SECRET_KEY=s3_password
MLFLOW_BUCKET=mlflow-artifacts
DVC_BUCKET=dvc-storage

# ── Host port mapping ─────────────────────────────────────────────────────────
# Container-internal ports stay at each tool's native default; only the HOST
# ports below are remapped into the 55xx block to avoid clashes with common
# local ports (macOS AirPlay uses 5000; a local Postgres uses 5432).
#   MLFLOW_PORT         host -> container 5000 (MLflow UI)
#   S3_API_PORT      host -> container 9000 (Silo S3 API; DVC's endpointurl)
#   S3_CONSOLE_PORT  host -> container 9001 (Silo console)
#   POSTGRES_HOST_PORT  host -> container 5432 (Postgres)
MLFLOW_PORT=5500
S3_API_PORT=5510
S3_CONSOLE_PORT=5511
POSTGRES_HOST_PORT=5532

# ── Pipeline (Python client) ──────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://127.0.0.1:5500
MLFLOW_EXPERIMENT_NAME=diabetes-week4

# The Week 1-3 canonical snapshot. Still git-committed, still byte-identical,
# so the Week 1-3 regression tests keep reproducing.
PIPELINE_DATA_PATH=data/diabetes.csv

# The DVC-tracked dataset — the file the pipeline actually trains on.
# It is legitimately ABSENT in a fresh clone until you run `dvc pull` (or
# rebuild it with `make build-data`), which is exactly why config.py does NOT
# check that this path exists.
PIPELINE_MEASUREMENTS_PATH=data/measurements.csv

# ── Where the hyperparameters went ────────────────────────────────────────────
# PIPELINE_RANDOM_SEED / PIPELINE_TEST_SIZE / PIPELINE_MAX_ITER are GONE from
# this file. They live in params.yaml now, because DVC can only hash a FILE — a
# value set through the environment is invisible to dvc.lock.

# ── Model registry (Week 3, unchanged) ────────────────────────────────────────
MLFLOW_REGISTERED_MODEL_NAME=diabetes-classifier
MLFLOW_MODEL_ALIAS=staging
MLFLOW_MODEL_OWNER=your-name

# ── DVC remote (new in Week 4) ────────────────────────────────────────────────
DVC_REMOTE_NAME=storage
DVC_REMOTE_PATH=dvcstore

# ── Credentials for DVC ───────────────────────────────────────────────────────
# Unlike the MLflow client, DVC talks to Silo DIRECTLY, so it needs keys. It
# reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the environment, and it
# does NOT read MLFLOW_S3_ENDPOINT_URL (the endpoint is DVC config instead).
#
# We do not duplicate the secrets here. The Makefile maps the Silo block above
# onto the AWS_* names for every dvc invocation, so one credential block serves
# both tools. To run dvc by hand:
#   set -a && . ./.env && set +a
#   export AWS_ACCESS_KEY_ID="$S3_ACCESS_KEY" AWS_SECRET_ACCESS_KEY="$S3_SECRET_KEY"
#
# The alternative is `dvc remote modify --local storage access_key_id ...`, which
# writes into .dvc/config.local. DVC git-ignores that file for you (look at the
# /config.local line in .dvc/.gitignore) — never commit it, never zip it up.
